# ============================================================
# Traccia — 開発ワークフロー用の設定（見本）
# ============================================================
#
# 使い方:
#   cp .env.example .env
#   （そのうえで .env に値を書く。.env は .gitignore で除外されている）
#
# 【注意】ここにあるのは Jira / Chatwork との連携に使う値で、
# **Traccia の動作には一切不要**。字幕を編集するだけ、文字起こしするだけなら
# .env は用意しなくてよい。
#
# 文字起こしに使う API キー（GEMINI_API_KEY / HF_TOKEN など）はここではなく、
# 環境変数か ~/.traccia/config.json（0600）で持つ。
#   → docs/api-keys.md ・ SECURITY.md
#
# 値は絶対にコミットしないこと。このファイルはキー名だけを置く見本で、
# 値は常に空にしておく。

# --- Jira -----------------------------------------------------
# 接続先の Atlassian サイト（例: https://your-site.atlassian.net）
JIRA_BASE_URL=
# Jira にログインしているメールアドレス
JIRA_USER_EMAIL=
# API トークン（https://id.atlassian.com/manage-profile/security/api-tokens で発行）
JIRA_API_TOKEN=
# 操作対象のプロジェクトキー（例: TRAC）
JIRA_PROJECT_KEY=

# --- Git ------------------------------------------------------
# PR を出す先のブランチ
BASE_BRANCH=

# --- Chatwork（レビュー依頼の通知に使う。使わないなら空のまま）----
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=
