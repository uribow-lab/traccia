# ============================================================
# Traccia — 話者別字幕ツール
# ============================================================

# --- 資格情報 ------------------------------------------------
# HuggingFace トークンが平文で書かれている。絶対にコミットしない。
mac_command.txt
win_実行コマンド.txt
*.token
hf_token*

# .env は派生形（.env.local / .env.production など）も含めて全部除外する。
# 中身が空の見本だけは、置きたくなったときのために通す。
.env
.env.*
!.env.example

# --- 仮想環境（各 1.4GB）------------------------------------
# requirements.txt から作り直せる
.venv/
venv/
venv.backup/
env/

# --- Python --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- 素材（動画 1本で 600〜900MB）---------------------------
# 動画も字幕も手元だけで持つ。Git に入れるものではない。
resources/
resources_bak/

# 字幕だけは版を残したい、という場合は上の resources/ を消して
# 代わりに以下を使う（動画とツールの生成物だけ除外する）
# resources/**/*.mp4
# resources/**/*.mov
# resources/**/*.mkv
# resources/**/*.m4v
# resources/**/*.webm
# resources/**/*.wav
# resources/**/*.m4a

# --- Traccia が作るファイル ---------------------------------
# いずれも元の .srt から作り直せる。原本ではない。
#
# 説明は必ず行を分ける。git は行末のコメントを認識しないので、
# 「*.edit.json          # 編集中のデータ」と書くと**その全体が 1 つのパターン**に
# なり、何にも当たらなくなる（この書き方で 7 行ぶん効いていなかった）。
#
# 編集中のデータ
*.edit.json
# 話者の名前と色
*.settings.json
# PCM 波形のピーク
*.peaks.json
# 反映した区切りの作法
*.style.json
# 作業時間の記録
*.worklog.json
# 保存中の一時ファイル
*.json.tmp
# 世代バックアップ（.edit.json.1 など）
*.json.[0-9]
# 診断の記録（モデルが返した生の時刻。発話がそのまま入る）
*.gemini-raw.*.json
*.diag-report.*.json
# 世代バックアップの置き場
backup/
# 書き出した話者別 .srt
export/

# --- 動画・音声（置き場所を問わず）-------------------------
*.mp4
*.mov
*.mkv
*.m4v
*.webm
*.wav
*.m4a
*.mp3

# --- 検証用（API 比較など。結果に音声の書き起こしが入る）-----
bench/

# --- 手元用のメモ・下書き（公開しない）------------------------
docs-local/

# --- Claude Code の手元設定 ---------------------------------
# 許可したコマンドや参照先のパスが入る。グローバルの gitignore で
# 除外していても、環境が変わればそのまま追跡されてしまうのでここでも書く。
.claude/settings.local.json

# --- ログ・作業ファイル -------------------------------------
*.log
run.log
*.bak
*.orig
*.tmp

# --- モデルのキャッシュ -------------------------------------
# 通常は ~/.cache に入るが、環境変数で手元に向けたとき用
.cache/
models/
*.bin
*.ct2

# --- macOS ---------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- Windows -------------------------------------------------
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- エディタ / IDE ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
